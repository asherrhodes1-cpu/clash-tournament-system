rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isStaff() {
      return isSignedIn() && request.auth.token.isStaff == true;
    }

    function myUsername() {
      return request.auth.token.username;
    }

    match /users/{uid} {
      allow read: if isSignedIn();
      // discordId is deliberately not in the list below: it's only ever set by
      // the /link command (Admin SDK), so a player can't type in someone
      // else's ID or a made-up one to get past the join requirement.
      allow update: if isSignedIn() && request.auth.uid == uid
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['clashTag', 'bio', 'avatarPath', 'country'])
                    && (!('bio' in request.resource.data) || (request.resource.data.bio is string && request.resource.data.bio.size() <= 300))
                    && (!('avatarPath' in request.resource.data) || request.resource.data.avatarPath is string)
                    && (!('country' in request.resource.data) || request.resource.data.country == '' || request.resource.data.country is int);
      allow create, delete: if false; // Admin SDK only, via the signUp Cloud Function
    }

    match /usernames/{usernameLower} {
      allow read: if isSignedIn();
      allow write: if false; // Admin SDK only, via the signUp Cloud Function
    }

    match /tournaments/{tournamentId} {
      // Public: anyone can browse tournaments, brackets and results without an
      // account - only joining and any other write needs one (see below).
      allow read: if true;
      allow create, delete: if isStaff();
      // Format and signup deadline both only make sense to change before
      // the bracket exists, so staff can only touch them while signups are
      // still open - not after matches already exist.
      allow update: if (isStaff()
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['format', 'signupDeadline'])
              || resource.data.status == 'signups_open')) ||
        (isSignedIn() && resource.data.status == 'signups_open'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['players'])
          && meetsJoinRequirements());

      // A player may only join a tournament if their verified Clash of Clans
      // stats satisfy the Builder Hall / trophy requirements staff set on it.
      function meetsJoinRequirements() {
        let profile = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
        let bhReq = resource.data.get('requiredBuilderHallLevel', null);
        let trophyReq = resource.data.get('minBestTrophies', null);
        // Live-section accounts are created without a Clash account, so a
        // verified one (API token, set by a Cloud Function only) is required
        // here. Joining also needs a Discord account linked with /link, so
        // every player can be reached about their matches.
        return profile.get('clashVerified', false) == true
            && profile.get('discordId', '') != ''
            && (bhReq == null || profile.get('builderHallLevel', -1) == bhReq)
            && (trophyReq == null || profile.get('bestBuilderBaseTrophies', -1) >= trophyReq);
      }

      // Each reward is a one-time prize link, so only the player it was
      // given to (and staff) can read it. Written by the dispenseRewards
      // Cloud Function only.
      // Running totals of correct predictions, written by the scoring function.
      match /predictionScores/{usernameLower} {
        allow read: if true;
        allow write: if false;
      }

      match /rewards/{usernameLower} {
        allow read: if isStaff() || (isSignedIn() && usernameLower == myUsername().lower());
        allow write: if false;
      }

      match /matches/{matchId} {
        // Public read, same reasoning as the tournament doc above.
        allow read: if true;
        allow write: if isStaff();

        function playerAlreadyVoted() {
          return (resource.data.player1 == myUsername() && resource.data.winner1Vote != null) ||
                 (resource.data.player2 == myUsername() && resource.data.winner2Vote != null);
        }

        // Each round unlocks a real 24h after it was actually created
        // (unlockAt, set once at creation) rather than a fixed multiple of
        // 24h from tournament start - the latter drifts out of sync with
        // reality the moment any earlier round runs long. Matches from
        // before unlockAt existed fall back to that old fixed-day formula.
        function roundIsUnlocked() {
          let t = get(/databases/$(database)/documents/tournaments/$(tournamentId)).data;
          let day = resource.data.get('day', resource.data.round);
          let fallbackUnlockAt = t.startedAt == null ? 0 : t.startedAt + (day - 1) * 86400000;
          let unlockAt = resource.data.get('unlockAt', fallbackUnlockAt);
          return t.startedAt == null || request.time.toMillis() >= unlockAt;
        }

        // A non-staff player may update only fields on a match they're actually part of,
        // and only before they've already submitted a result for it.
        allow update: if isSignedIn() &&
          (resource.data.player1 == myUsername() || resource.data.player2 == myUsername()) &&
          !playerAlreadyVoted() &&
          roundIsUnlocked() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'player1Ready', 'player1ReadyTime', 'player2Ready', 'player2ReadyTime',
            'winner1Vote', 'player1VoteTime', 'winner2Vote', 'player2VoteTime',
            'player1ScreenshotPaths', 'player2ScreenshotPaths', 'status', 'scheduledStartTime',
            'winner', 'completedAt'
          ]);

        // Anyone signed in can predict who wins a match while it's still
        // pending - except the two players in it - and change their pick until
        // it starts. `correct` is only ever written by the scoring Cloud
        // Function, so a client can't award itself points.
        match /predictions/{uid} {
          function openMatch() {
            let m = get(/databases/$(database)/documents/tournaments/$(tournamentId)/matches/$(matchId)).data;
            return m.status == 'pending' && m.player2 != 'BYE'
                && myUsername() != m.player1 && myUsername() != m.player2;
          }
          function pickIsAPlayer() {
            let m = get(/databases/$(database)/documents/tournaments/$(tournamentId)/matches/$(matchId)).data;
            return request.resource.data.pick == m.player1 || request.resource.data.pick == m.player2;
          }
          allow read: if isSignedIn();
          allow create: if isSignedIn() && request.auth.uid == uid && openMatch() && pickIsAPlayer()
                        && request.resource.data.keys().hasOnly(['username', 'pick', 'createdAt'])
                        && request.resource.data.username == myUsername();
          allow update: if isSignedIn() && request.auth.uid == uid && openMatch() && pickIsAPlayer()
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pick']);
          allow delete: if false;
        }

        match /messages/{messageId} {
          function isMatchParticipant() {
            let m = get(/databases/$(database)/documents/tournaments/$(tournamentId)/matches/$(matchId)).data;
            return isSignedIn() && (m.player1 == myUsername() || m.player2 == myUsername());
          }
          allow read: if isMatchParticipant() || isStaff();
          allow create: if (isMatchParticipant() || isStaff())
                        && request.resource.data.sender == myUsername()
                        && request.resource.data.keys().hasOnly(['sender', 'text', 'timestamp']);
          allow update, delete: if false;
        }
      }
    }

    // Collection-group read rule: the dashboard's "Pending Matches" stat queries
    // across every tournament's matches subcollection at once via
    // collectionGroup('matches'). The nested rule above only applies when
    // Firestore can scope the query to one known tournament - a true collection
    // group query needs this wildcard form to be granted read access at all.
    match /{path=**}/matches/{matchId} {
      allow read: if true;
    }

    // Live streams. Everything is publicly readable because the OBS overlay
    // (/live/overlay) runs without an account.
    // live/state: the stream link and which betting round is featured.
    match /live/{docId} {
      allow read: if true;
      allow write: if isStaff();
    }

    // A betting round: will the streamer succeed or fail? Staff open and
    // close betting here; settling (payouts) is the settleLiveRound Cloud
    // Function only, so once a round is settling staff can't reopen it.
    match /liveRounds/{roundId} {
      allow read: if true;
      // Betting runs for bettingMs from openedAt (the countdown), and
      // openedAt has to be the server's own time so a wrong clock on the
      // streamer's computer can't stretch it. placeLiveBet enforces the end.
      allow create: if isStaff()
                    && request.resource.data.keys().hasOnly(['description', 'kind', 'status', 'result', 'createdBy', 'createdAt', 'openedAt', 'bettingMs'])
                    && request.resource.data.get('kind', 'outcome') in ['outcome', 'stars']
                    && request.resource.data.description is string
                    && request.resource.data.description.size() > 0
                    && request.resource.data.description.size() <= 200
                    && request.resource.data.status == 'open'
                    && request.resource.data.result == null
                    && request.resource.data.openedAt == request.time
                    && request.resource.data.bettingMs is int
                    && request.resource.data.bettingMs > 0
                    && request.resource.data.bettingMs <= 600000;
      // Close betting early, or reopen it (which restarts the countdown).
      allow update: if isStaff()
                    && resource.data.status in ['open', 'closed']
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'openedAt'])
                    && request.resource.data.status in ['open', 'closed']
                    && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['openedAt'])
                        || request.resource.data.openedAt == request.time);
      allow delete: if false;

      // Written by the placeLiveBet / settleLiveRound Cloud Functions only.
      match /bets/{uid} {
        allow read: if true;
        allow write: if false;
      }
    }

    // The 1v1 ladder. Its matches are ordinary match docs under
    // tournaments/ladder (so the match rules above cover them); these are the
    // Elo ratings and the matchmaking queue, both written only by Cloud
    // Functions (rateLadderMatch, joinLadderQueue / leaveLadderQueue).
    match /ladderRatings/{usernameLower} {
      allow read: if true;
      allow write: if false;
    }
    match /ladderQueue/{uid} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // Community challenge goals: viewers donate gems toward the target, then
    // donors vote on a challenge. Staff create a goal here (with `pool`, a
    // snapshot of their challenge list from live/challenges); donating,
    // voting, and cancelling are Cloud Functions only.
    match /challengeGoals/{goalId} {
      allow read: if true;
      allow create: if isStaff()
                    && request.resource.data.keys().hasOnly(['target', 'raised', 'status', 'pool', 'createdBy', 'createdAt'])
                    && request.resource.data.target is int
                    && request.resource.data.target >= 1
                    && request.resource.data.target <= 1000000
                    && request.resource.data.raised == 0
                    && request.resource.data.status == 'collecting'
                    && request.resource.data.pool is list
                    && request.resource.data.pool.size() >= 2
                    && request.resource.data.pool.size() <= 50;
      allow update, delete: if false;

      match /donations/{uid} {
        allow read: if true;
        allow write: if false;
      }
    }

    // Gem drops: free gems staff hand out for a short window. Staff create
    // one here (openedAt must be server time, so the countdown can't be
    // stretched); claiming is the claimGemDrop Cloud Function only.
    match /gemDrops/{dropId} {
      allow read: if true;
      allow create: if isStaff()
                    && request.resource.data.keys().hasOnly(['amount', 'durationMs', 'openedAt', 'createdBy', 'createdAt'])
                    && request.resource.data.amount is int
                    && request.resource.data.amount >= 1
                    && request.resource.data.amount <= 100000
                    && request.resource.data.durationMs is int
                    && request.resource.data.durationMs >= 5000
                    && request.resource.data.durationMs <= 600000
                    && request.resource.data.openedAt == request.time;
      allow update, delete: if false;

      match /claims/{uid} {
        allow read: if true;
        allow write: if false;
      }
    }

    // League Roulette spins, logged by the spinRoulette Cloud Function for
    // the public "recent spins" feed.
    match /rouletteSpins/{spinId} {
      allow read: if true;
      allow write: if false;
    }

    // Pretend-currency balances, public for the leaderboard. Cloud Functions
    // only - a client can never set its own gems.
    match /gemBalances/{uid} {
      allow read: if true;
      allow write: if false;
    }

    match /flags/{flagId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.createdBy == myUsername()
                    && request.resource.data.status == 'open';
      allow update: if isStaff() ||
        (isSignedIn() && resource.data.createdBy == myUsername()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['responses']));
    }
  }
}
