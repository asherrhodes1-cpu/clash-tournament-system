{
  "installCommand": "cd tournament && npm install",
  "buildCommand": "cd tournament && npm run build",
  "outputDirectory": "tournament/build",
  "rewrites": [
    {
      "source": "/tournaments/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ]
}
