{
  "buildCommand": "cd tournament && npm run build",
  "outputDirectory": "tournament/build",
  "routes": [
    {
      "src": "^/$",
      "dest": "/index.html"
    },
    {
      "src": "^/tournaments(/)?$",
      "dest": "/tournaments/index.html"
    },
    {
      "src": "^/tournaments/.*",
      "dest": "/tournaments/index.html"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
